NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
# Email transactionnel : configure Brevo OU Resend (Brevo est utilisé en priorité si les deux sont présentes).
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@eventpro.app
EMAIL_FROM_NAME=EventPro
RESEND_API_KEY=
RESEND_FROM_EMAIL=EventPro <onboarding@resend.dev>
CRON_SECRET=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Paiement K-Pay (kpay.site) — https://kpay.site/documentation
KPAY_API_KEY=
KPAY_SECRET_KEY=
# Secret dédié au webhook (page de config du endpoint dans le dashboard K-Pay), distinct de KPAY_SECRET_KEY
KPAY_WEBHOOK_SECRET=
# Secret interne (généré une fois, doit correspondre à app_secrets.payment_secret en base)
PAYMENT_INTERNAL_SECRET=
